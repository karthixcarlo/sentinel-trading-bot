# ============================================================
# Project Sentinel — .gitignore
# Only track: agents/, dashboard_v3/, core *.py, config files
# ============================================================

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# --- Local dev tools (never push) ---
dev_sync_watcher.py


# --- Python cache ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.Python

# --- Distribution / build ---
*.egg-info/
*.egg
build/
dist/
develop-eggs/
eggs/
.eggs/
MANIFEST
pip-wheel-metadata/
wheels/

# --- Databases (never commit live data) ---
*.db
*.sqlite3
*.sqlite3-journal

# --- Environment secrets ---
.env
.env.local
.env.*.local

# --- Test / coverage artifacts ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
*.cover
nosetests.xml

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Cache ---
.cache/
temp/
tmp/

# --- Streamlit ---
.streamlit/

# --- Type checkers ---
.mypy_cache/
.pyre/
.dmypy.json
dmypy.json

# --- Skills / Agent tooling (local dev only) ---
.agents/
.agent/
skills-lock.json

# --- Old/junk files not part of active project ---
styles.py
TODO.md
ALPACA_SETUP.md
INDIAN_MARKET_SETUP.md
PROJECT_COMPLETE.md
PROJECT_DOCUMENTATION.md
DASHBOARD_GUIDE.md
QUICKSTART.md
api_test_result.txt

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Mypy ---
mypy_report/

# --- Render / Supabase local caches ---
.render/
