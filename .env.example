# Gemini / Google AI (used by Copilot, Analyze)
GOOGLE_API_KEY=your_google_api_key_here
# Alternative: GEMINI_API_KEY=your_key_here

# Supabase (portfolio, transactions, agent_logs - app shows demo data when unset)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Trading Bot Settings
INITIAL_CAPITAL=100000
BROKERAGE_RATE=0.0003

# API Keys (if needed)
# ZERODHA_API_KEY=your_zerodha_key
# ZERODHA_API_SECRET=your_zerodha_secret
